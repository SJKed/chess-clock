{
  "name": "Chess Clock",
  "short_name": "Chess Clock",
  "description": "A two-player chess clock. Tap your side to pass the turn.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "portrait",
  "background_color": "#121212",
